  "events": [
    {
      "id": "s11-open",
      "trigger": { "type": "battleStart" },
      "actions": [
        {
          "type": "dialogue",
          "lines": [
            {
              "speaker": "caocao",
              "text": "하비요. 눈 덮인 들을 건너 다리 둘로 강을 넘고, 문 하나를 부수면 끝이오."
            },
            {
              "speaker": "lüBu",
              "text": "조조! 성 안에서 굶어 죽으라고? 나와서 죽여 주마!"
            },
            {
              "speaker": "caocao",
              "text": "…….이 악천후에 불은 쓸 수 없소. 창으로만 끝내야 하오."
            }
          ]
        }
      ]
    },
    {
      "id": "s11-duel-diaochan",
      "trigger": {
        "type": "unitsMeet",
        "a": "diaochan",
        "b": "caocao"
      },
      "actions": [
        {
          "type": "duel",
          "a": "caocao",
          "b": "diaochan",
          "lines": [
            {
              "speaker": "diaochan",
              "text": "……조공. 이 성에서 나가는 길을 아십니까."
            },
            {
              "speaker": "caocao",
              "text": "…….물러서시오. 그대와 겨루러 온 것이 아니오."
            },
            {
              "speaker": "diaochan",
              "text": "여포님의 뒤에는 제가 섭니다. 비켜 드릴 수는 없습니다."
            },
            {
              "speaker": null,
              "text": "짧은 칼과 검이 한 번 엇갈렸다. 조조는 검을 내리고 말머리를 돌렸다."
            }
          ],
          "outcome": {
            "draw": true
          }
        }
      ]
    },
    {
      "id": "s11-duel-houcheng",
      "trigger": {
        "type": "unitsMeet",
        "a": "houCheng",
        "b": "caocao"
      },
      "actions": [
        {
          "type": "duel",
          "a": "caocao",
          "b": "houCheng",
          "lines": [
            {
              "speaker": "houCheng",
              "text": "조조! 여포님의 이름을 걸고 네 목을 가져간다!"
            },
            {
              "speaker": "caocao",
              "text": "…….이름을 걸 상대를 잘못 골랐소."
            },
            {
              "speaker": null,
              "text": "후성의 창이 허공을 갈랐다. 되돌아온 검이 그 목을 스쳤다."
            }
          ],
          "outcome": {
            "winner": "a",
            "loserFate": "die"
          }
        }
      ]
    },
    {
      "id": "s11-duel-weixu",
      "trigger": {
        "type": "unitsMeet",
        "a": "weiXu",
        "b": "xiahoudun"
      },
      "actions": [
        {
          "type": "duel",
          "a": "xiahoudun",
          "b": "weiXu",
          "lines": [
            {
              "speaker": "weiXu",
              "text": "애꾸눈 장군이 앞장을 서다니, 하비도 우습게 보였군!"
            },
            {
              "speaker": "xiahoudun",
              "text": "…….눈은 하나면 되오. 창은 둘 다 쓰오."
            },
            {
              "speaker": null,
              "text": "위속의 말이 두 걸음 물러나기 전에, 하후돈의 창이 먼저 닿았다."
            }
          ],
          "outcome": {
            "winner": "a",
            "loserFate": "die"
          }
        }
      ]
    },
    {
      "id": "s11-duel-songxian",
      "trigger": {
        "type": "unitsMeet",
        "a": "songXian",
        "b": "xiahouyuan"
      },
      "actions": [
        {
          "type": "duel",
          "a": "xiahouyuan",
          "b": "songXian",
          "lines": [
            {
              "speaker": "songXian",
              "text": "여포님이 나서기 전에 네 놈부터 치운다!"
            },
            {
              "speaker": "xiahouyuan",
              "text": "…….기다릴 필요 없소. 여기서 끝냅시다."
            },
            {
              "speaker": null,
              "text": "송헌의 창이 빗발에 미끄러졌다. 하후연은 그 틈을 놓치지 않았다."
            }
          ],
          "outcome": {
            "winner": "a",
            "loserFate": "die"
          }
        }
      ]
    },
